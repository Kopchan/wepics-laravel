# Optional overrides for `docker compose up` — copy to `docker.env` to use.
# Everything else (DB/Redis passwords, APP_KEY, drivers, wiring) is pinned
# as literals inside docker-compose.yml and can NOT be set here.
# Your dev `.env` (DDEV/XAMPP) is ignored by the prod stack by design.
APP_NAME=Wepics
APP_URL=http://localhost:8080
UPLOAD_ENABLE=true
# Build args (affect image size and capabilities):
# WITH_NODE=true  — install nodejs+npm in app image (for local Browsershot fallback)
# WITH_NODE=false — smaller image, requires --profile chromium for OG screenshots
WITH_NODE=true
#UPLOAD_DISABLE_PERCENTAGE=90
#DEFAULT_QUOTA_BYTES=0
#ALLOWED_EXT_IMAGE=jpeg,jpg,png,gif,webp,avif
#ALLOWED_EXT_VIDEO=mp4,mp4v,webm,mkv
#ALLOWED_EXT_AUDIO=mp3,ogg,flac,opus
#ALLOWED_PREVIEW_SIZES=144,240,360,480,720,1080
# Optional: pin APP_KEY instead of auto-generating it into the `state` volume.
#APP_KEY=base64:...
